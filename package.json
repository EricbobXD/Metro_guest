{
  "name": "rail-sprint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/export-north-map.mjs && vite build",
    "export:map": "node scripts/export-north-map.mjs",
    "optimize:map": "node scripts/optimize-north-map.mjs && node scripts/export-north-map.mjs",
    "audit:map": "node scripts/audit-north-map.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^30.1.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
